---
import "../styles/global.css";
import ru from "../i18n/ru.json";
import en from "../i18n/en.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Бухта Coffee Roasters",
  description = "Свежеобжаренный кофе собственной обжарки в Калининграде и Зеленоградске. Попробуйте спешелти кофе в приятной атмосфере тихой гавани."
} = Astro.props;

// Pass translations to client-side script
const translationsJson = JSON.stringify({ ru, en });
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Source Serif 4 + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">

    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <!-- Client-side Translations + Language Switcher -->
    <script is:inline define:vars={{ translationsJson }}>
      window.__translations = JSON.parse(translationsJson);

      // Get saved language or default to 'ru'
      const savedLang = localStorage.getItem("bukhta-lang");
      window.__currentLang = savedLang === "en" ? "en" : "ru";

      // Apply correct lang attribute to html
      document.documentElement.lang = window.__currentLang;

      // Translate the page
      window.translatePage = function(lang) {
        window.__currentLang = lang;
        localStorage.setItem("bukhta-lang", lang);
        document.documentElement.lang = lang;

        // Translate all [data-i18n] elements
        const elements = document.querySelectorAll("[data-i18n]");
        elements.forEach((el) => {
          const path = el.getAttribute("data-i18n");
          if (!path) return;

          const keys = path.split(".");
          let text = window.__translations[lang];

          for (const key of keys) {
            if (text && typeof text === "object" && key in text) {
              text = text[key];
            } else {
              text = null;
              break;
            }
          }

          if (typeof text === "string") {
            if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
              el.setAttribute("placeholder", text);
            } else if (el.tagName === "IFRAME") {
              el.setAttribute("title", text);
            } else {
              el.textContent = text;
            }
          }
        });

        // Translate mailto buttons
        const mailtoButtons = document.querySelectorAll("[data-mailto-type]");
        mailtoButtons.forEach((btn) => {
          const type = btn.getAttribute("data-mailto-type");
          const email = btn.getAttribute("data-mailto-email") || "hello@bukhta.coffee";

          let subject = "";
          let body = "";

          if (type === "beans") {
            subject = lang === "ru" ? "Заказ зерна" : "Order coffee beans";
            body = lang === "ru" ? "Здравствуйте! Я бы хотел заказать кофе в зернах..." : "Hello! I would like to order coffee beans...";
          } else if (type === "card") {
            subject = lang === "ru" ? "Подарочная карта" : "Gift card";
            body = lang === "ru" ? "Здравствуйте! Я бы хотел приобрести подарочную карту..." : "Hello! I would like to purchase a gift card...";
          } else if (type === "cupping") {
            subject = lang === "ru" ? "Запись на каппинг" : "Cupping registration";
            body = lang === "ru" ? "Здравствуйте! Запишите меня, пожалуйста, на ближайший каппинг..." : "Hello! Please sign me up for the next cupping session...";
          } else if (type === "career") {
            subject = lang === "ru" ? "Отклик на вакансию" : "Job application";
            body = lang === "ru" ? "Здравствуйте! Я пишу по поводу вакансии..." : "Hello! I am writing in response to the job vacancy...";
          }

          btn.setAttribute("href", `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`);
        });

        // Translate menu item names (data-menu-name-ru / data-menu-name-en)
        document.querySelectorAll("[data-menu-name-ru]").forEach((el) => {
          const text = el.getAttribute(`data-menu-name-${lang}`);
          if (text) el.textContent = text;
        });

        // Translate location card fields (data-location-name-ru/en, data-location-address-ru/en, data-location-hours-ru/en)
        document.querySelectorAll("[data-location-name-ru]").forEach((el) => {
          const text = el.getAttribute(`data-location-name-${lang}`);
          if (text) el.textContent = text;
        });
        document.querySelectorAll("[data-location-address-ru]").forEach((el) => {
          const text = el.getAttribute(`data-location-address-${lang}`);
          if (text) el.textContent = text;
        });
        document.querySelectorAll("[data-location-hours]").forEach((el) => {
          const ru_hours = el.getAttribute("data-location-hours-ru");
          const en_hours = el.getAttribute("data-location-hours-en");
          const hours = lang === "en" ? en_hours : ru_hours;
          if (hours) el.textContent = hours;
        });


        // Notify React components about language change
        window.dispatchEvent(new CustomEvent("langChange", { detail: { lang } }));

        // Update language switcher active states
        // Active lang: bold text + bottom border in primary navy
        // Inactive: muted text, transparent border
        const switchers = document.querySelectorAll("[data-lang-btn]");
        switchers.forEach((btn) => {
          const btnLang = btn.getAttribute("data-lang-btn");
          if (btnLang === lang) {
            btn.classList.add("text-primary", "border-primary", "font-bold");
            btn.classList.remove("text-on-surface-variant", "border-transparent");
          } else {
            btn.classList.remove("text-primary", "border-primary", "font-bold");
            btn.classList.add("text-on-surface-variant", "border-transparent");
          }
        });
      };

      // Run once DOM is ready
      document.addEventListener("DOMContentLoaded", () => {
        window.translatePage(window.__currentLang);
      });
    </script>
  </head>
  <body class="bg-surface text-on-surface antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
