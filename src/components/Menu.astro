---
import ru from "../i18n/ru.json";
import { menuData } from "../data/menu";
import { contactsData } from "../data/contacts";

const t = ru.menu;
const email = contactsData.email;
---

<section id="menu" class="py-24 sm:py-32 relative bg-stone-900/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        <span data-i18n="menu.title">{t.title}</span>
      </h2>
      <div class="h-1 w-20 bg-amber-500 rounded-full mx-auto mb-6"></div>
      <p class="text-stone-400 text-base sm:text-lg">
        <span data-i18n="menu.subtitle">{t.subtitle}</span>
      </p>
    </div>

    <!-- Menu Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-8 items-start mb-16">
      {menuData.map((section) => (
        <div class="bg-stone-900/40 border border-stone-850 p-6 sm:p-8 rounded-2xl backdrop-blur-sm space-y-6">
          <h3 class="text-lg sm:text-xl font-bold text-amber-500 font-serif tracking-wide border-b border-stone-800 pb-3 uppercase">
            <span data-i18n={`menu.${section.titleKey}`}>{t[section.titleKey as keyof typeof t] || section.titleKey}</span>
          </h3>
          
          <div class="space-y-6">
            {section.items.map((item) => (
              <div class="group">
                <div class="flex justify-between items-baseline gap-4 mb-1">
                  <h4 class="text-stone-200 font-medium group-hover:text-white transition-colors duration-200 text-sm sm:text-base">
                    <span>{item.name.ru}</span>
                  </h4>
                  <span class="flex-grow border-b border-dashed border-stone-800 mx-2"></span>
                  <span class="text-amber-500 font-semibold font-mono text-sm sm:text-base">{item.price} ₽</span>
                </div>
                {item.description && (
                  <p class="text-stone-500 text-xs sm:text-sm leading-relaxed">
                    <span>{item.description.ru}</span>
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Order CTA -->
    <div class="text-center bg-stone-900/30 border border-stone-850 p-8 sm:p-12 rounded-2xl max-w-3xl mx-auto">
      <p class="text-stone-300 text-sm sm:text-base mb-6 leading-relaxed">
        Хотите заказать свежеобжаренное зерно с доставкой на дом или в офис? Напишите нам прямо сейчас.
      </p>
      <a
        data-mailto-type="beans"
        data-mailto-email={email}
        data-i18n="menu.order_button"
        href={`mailto:${email}?subject=${encodeURIComponent("Заказ зерна")}`}
        class="inline-block px-8 py-4 bg-amber-800 hover:bg-amber-700 text-white font-medium rounded-xl shadow-lg transition-all duration-300"
      >
        {t.order_button}
      </a>
    </div>

  </div>
</section>
