---
import ru from "../i18n/ru.json";
import { menuData } from "../data/menu";
import { contactsData } from "../data/contacts";

const t = ru.menu;
---

<section id="menu" class="py-20 px-4 md:px-[48px]" style="background-color: #f5f3ee;">
  <div class="max-w-[1200px] mx-auto">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2
        data-i18n="menu.title"
        class="mb-4"
        style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
      >
        {t.title}
      </h2>
      <p
        data-i18n="menu.subtitle"
        style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d; max-width: 42rem; margin: 0 auto;"
      >
        {t.subtitle}
      </p>
    </div>

    <!-- Menu Grid: Espresso | Alternative + Food -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 mb-16">

      <!-- Left Column: Espresso Base -->
      <div>
        <h3 class="flex items-center gap-2 pb-2 mb-6" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #021a35; border-bottom: 2px solid #815500;">
          <span class="material-symbols-outlined" style="color: #021a35;">coffee</span>
          <span data-i18n="menu.espresso_base">{t.espresso_base}</span>
        </h3>
        <ul class="space-y-6">
          {menuData[0].items.map((item) => (
            <li class="flex justify-between items-baseline pb-2" style="border-bottom: 1px dashed #e4e2dd;">
              <span
                data-i18n={`menu_items.${item.id}.name`}
                style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #021a35;"
              >
                {item.name.ru}
              </span>
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d;">
                {item.price}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Column: Alternative + Food -->
      <div>
        <h3 class="flex items-center gap-2 pb-2 mb-6" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #021a35; border-bottom: 2px solid #815500;">
          <span class="material-symbols-outlined" style="color: #021a35;">water_drop</span>
          <span data-i18n="menu.alternative">{t.alternative}</span>
        </h3>
        <ul class="space-y-6 mb-12">
          {menuData[1].items.map((item) => (
            <li class="flex justify-between items-baseline pb-2" style="border-bottom: 1px dashed #e4e2dd;">
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #021a35;">
                {item.name.ru}
              </span>
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d;">
                {item.price}
              </span>
            </li>
          ))}
        </ul>

        <h3 class="flex items-center gap-2 pb-2 mb-6" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #021a35; border-bottom: 2px solid #815500;">
          <span class="material-symbols-outlined" style="color: #021a35;">bakery_dining</span>
          <span data-i18n="menu.food">{t.food}</span>
        </h3>
        <ul class="space-y-6">
          {menuData[2].items.map((item) => (
            <li class="flex justify-between items-baseline pb-2" style="border-bottom: 1px dashed #e4e2dd;">
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #021a35;">
                {item.name.ru}
              </span>
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d;">
                {item.price}
              </span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Order Button -->
    <div class="text-center">
      <a
        href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Заказ зерна')}`}
        data-mailto-type="beans"
        data-mailto-email={contactsData.email}
        class="inline-flex items-center gap-2 transition-all duration-300 hover:opacity-90 hover:shadow-md"
        style="background-color: #815500; color: #ffffff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; padding: 16px 32px; border-radius: 9999px; box-shadow: 0 2px 8px rgba(26, 47, 75, 0.12); text-decoration: none;"
      >
        <span class="material-symbols-outlined" style="font-size: 20px;">shopping_bag</span>
        <span data-i18n="menu.order_button">{t.order_button}</span>
      </a>
    </div>

  </div>
</section>
