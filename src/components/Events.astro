---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";
import { InteractiveHoverButton } from "./ui/interactive-hover-button";

const t = ru.events;
---

<section id="events" class="py-20 px-4 md:px-[48px]" style="background-color: #fbf9f4;">
  <div class="max-w-[1200px] mx-auto text-center">

    <h2
      data-i18n="events.title"
      class="mb-6"
      style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
    >
      {t.title}
    </h2>

    <p
      data-i18n="events.description"
      class="mx-auto mb-10"
      style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #44474d; max-width: 42rem;"
    >
      {t.description}
    </p>

    <InteractiveHoverButton
      client:load
      href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Запись на каппинг')}`}
      data-mailto-type="cupping"
      data-mailto-email={contactsData.email}
      text={t.button}
      data-i18n="events.button"
      variant="secondary"
      className="shadow-md hover:scale-105 transition-transform duration-300"
    />

  </div>
</section>
