---
import ru from "../i18n/ru.json";
import { InteractiveHoverButton } from "./ui/interactive-hover-button";

const t = ru.hero;
---

<header
  id="hero"
  class="relative w-full flex items-center justify-center overflow-hidden"
  style="min-height: 600px; height: 819px; background-color: #1a2f4b;"
>
  <!-- Background Image -->
  <div
    class="absolute inset-0 z-0 bg-cover bg-center"
    style="background-image: url('/images/hero/roastery.jpg'); opacity: 0.4; mix-blend-mode: overlay;"
    role="img"
    aria-label="Панорама кофейной обжарочной у Балтийского моря"
  ></div>

  <!-- Gradient Overlay -->
  <div
    class="absolute inset-0 z-0"
    style="background: linear-gradient(to top, #1a2f4b 0%, transparent 100%); opacity: 0.8;"
  ></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 md:px-[48px] max-w-[1200px] mx-auto">
    <h1
      data-i18n="hero.tagline"
      class="mb-6"
      style="font-family: 'Source Serif 4', Georgia, serif; font-size: clamp(32px, 5vw, 48px); font-weight: 700; line-height: 1.17; letter-spacing: -0.02em; color: #ffffff;"
    >
      {t.tagline}
    </h1>
    <p
      data-i18n="hero.subtagline"
      class="mx-auto mb-10"
      style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #8397b8; max-width: 42rem;"
    >
      {t.subtagline}
    </p>
    <InteractiveHoverButton
      client:load
      href="#history"
      text={t.cta}
      data-i18n="hero.cta"
      variant="secondary"
      className="shadow-lg hover:scale-105 transition-transform duration-300"
    />
  </div>
</header>
