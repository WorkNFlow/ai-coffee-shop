---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";

const t = ru.footer;
---

<footer style="background-color: #021a35;">
  <div
    class="w-full flex flex-col md:flex-row justify-between items-center gap-6 py-12 px-4 md:px-[48px] max-w-[1200px] mx-auto"
  >

    <!-- Brand Logo -->
    <div class="flex items-center gap-2 mb-6 md:mb-0">
      <span class="material-symbols-outlined filled" style="color: #ffb94d; font-size: 28px;">sailing</span>
      <span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #ffb94d;">Bukhta Coffee Roasters</span>
    </div>

    <!-- Footer Links -->
    <div class="flex flex-wrap justify-center gap-6">
      <a
        href={contactsData.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-200 text-[#8397b8] hover:text-[#ffddb2] font-semibold text-sm tracking-wider"
      >
        Instagram
      </a>
      <a
        href={contactsData.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-200 text-[#8397b8] hover:text-[#ffddb2] font-semibold text-sm tracking-wider"
      >
        Telegram
      </a>
      <a
        href={`mailto:${contactsData.email}`}
        class="transition-colors duration-200 text-[#8397b8] hover:text-[#ffddb2] font-semibold text-sm tracking-wider"
      >
        Email
      </a>
      <a
        href={`tel:${contactsData.phone.replace(/\D/g, '')}`}
        class="transition-colors duration-200 text-[#8397b8] hover:text-[#ffddb2] font-semibold text-sm tracking-wider"
      >
        Телефон
      </a>
    </div>

    <!-- Copyright -->
    <div class="mt-6 md:mt-0 text-center md:text-right">
      <p class="text-[#8397b8] text-base font-normal leading-relaxed">
        © 2019–2026 <span data-i18n="nav.brand">Бухта Coffee Roasters</span>. <span data-i18n="footer.rights">{t.rights}</span>
      </p>
    </div>

  </div>
</footer>
