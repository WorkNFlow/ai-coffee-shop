---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";
import { InteractiveHoverButton } from "./ui/interactive-hover-button";

const t = ru.roasting;
---

<section id="roasting" class="py-20 px-4 md:px-[48px]" style="background-color: #fbf9f4;">
  <div class="max-w-[1200px] mx-auto">
    <div class="flex flex-col md:flex-row-reverse items-center gap-12">

      <!-- Text Content -->
      <div class="w-full md:w-1/2">
        <h2
          data-i18n="roasting.title"
          class="mb-6"
          style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
        >
          {t.title}
        </h2>
        <p
          data-i18n="roasting.description_1"
          class="mb-4"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #1b1c19;"
        >
          {t.description_1}
        </p>
        <p
          data-i18n="roasting.description_2"
          class="mb-8"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #1b1c19;"
        >
          {t.description_2}
        </p>

        <!-- Bean of the Month card -->
        <div class="mb-8 p-6" style="background-color: #f5f3ee; border-radius: 1rem; border: 1px solid rgba(196, 198, 206, 0.3);">
          <h4
            data-i18n="roasting.subscription"
            class="mb-2 uppercase"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #815500;"
          >
            {t.subscription}
          </h4>
          <p
            data-i18n="roasting.subscription_desc"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d;"
          >
            {t.subscription_desc}
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4">
          <InteractiveHoverButton
            client:load
            href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Заказ зерна')}`}
            data-mailto-type="beans"
            data-mailto-email={contactsData.email}
            text={t.order_beans}
            data-i18n="roasting.order_beans"
            variant="primary"
            className="shadow-sm hover:scale-105 transition-transform duration-300"
          />
          <InteractiveHoverButton
            client:load
            href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Подарочная карта')}`}
            data-mailto-type="card"
            data-mailto-email={contactsData.email}
            text={t.order_gift_card}
            data-i18n="roasting.order_gift_card"
            variant="primary"
            className="shadow-sm hover:scale-105 transition-transform duration-300"
          />
        </div>
      </div>

      <!-- Photo -->
      <div
        class="w-full md:w-1/2 relative overflow-hidden"
        style="border-radius: 1rem; background-color: #f0eee9; height: 500px;"
      >
        <div
          class="absolute inset-0 bg-cover bg-center"
          style="background-image: url('/images/roasting/beans.jpg');"
          role="img"
          aria-label="Кофейные зёрна и процесс обжарки"
        ></div>
      </div>

    </div>
  </div>
</section>
