---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";
import { InteractiveHoverButton } from "./ui/interactive-hover-button";

const t = ru.roasting;
---

<section id="roasting" class="py-20 px-4 md:px-[48px]" style="background-color: #021a35;">
  <div class="max-w-[1200px] mx-auto">
    <div class="flex flex-col md:flex-row-reverse items-center gap-12">

      <!-- Text Content -->
      <div class="w-full md:w-1/2">
        <h2
          data-i18n="roasting.title"
          class="mb-6 text-white font-serif text-3xl md:text-4xl font-semibold leading-snug"
        >
          {t.title}
        </h2>
        <p
          data-i18n="roasting.description_1"
          class="mb-4 text-[#8397b8] text-lg font-normal leading-relaxed"
        >
          {t.description_1}
        </p>
        <p
          data-i18n="roasting.description_2"
          class="mb-8 text-[#8397b8] text-lg font-normal leading-relaxed"
        >
          {t.description_2}
        </p>

        <!-- Bean of the Month card -->
        <div class="mb-8 p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
          <h4
            data-i18n="roasting.subscription"
            class="mb-2 uppercase text-[#fdb647] text-sm font-semibold tracking-wider"
          >
            {t.subscription}
          </h4>
          <p
            data-i18n="roasting.subscription_desc"
            class="text-[#b3c8eb] text-base font-normal leading-relaxed"
          >
            {t.subscription_desc}
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4">
          <InteractiveHoverButton
            client:load
            href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Заказ зерна')}`}
            data-mailto-type="beans"
            data-mailto-email={contactsData.email}
            text={t.order_beans}
            data-i18n="roasting.order_beans"
            variant="white"
            className="shadow-sm hover:scale-105 transition-transform duration-300"
          />
          <InteractiveHoverButton
            client:load
            href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Подарочная карта')}`}
            data-mailto-type="card"
            data-mailto-email={contactsData.email}
            text={t.order_gift_card}
            data-i18n="roasting.order_gift_card"
            variant="white"
            className="shadow-sm hover:scale-105 transition-transform duration-300 border-2 bg-white/10 backdrop-blur-sm"
          />
        </div>
      </div>

      <!-- Photo -->
      <div
        class="w-full md:w-1/2 relative overflow-hidden rounded-2xl shadow-xl"
        style="background-color: #1a2f4b; height: 500px;"
      >
        <div
          class="absolute inset-0 bg-cover bg-center"
          style="background-image: url('/images/roasting/beans.jpg');"
          role="img"
          aria-label="Кофейные зёрна и процесс обжарки"
        ></div>
      </div>

    </div>
  </div>
</section>
