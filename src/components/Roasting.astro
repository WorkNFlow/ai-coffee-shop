---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";

const t = ru.roasting;
const email = contactsData.email;
---

<section id="roasting" class="py-24 sm:py-32 relative overflow-hidden bg-stone-900/30">
  <!-- Subtle ambient light background -->
  <div class="absolute right-0 top-1/4 w-96 h-96 bg-amber-950/20 rounded-full blur-3xl -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      
      <!-- Left side: Description & approach -->
      <div class="lg:col-span-6 space-y-6">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          <span data-i18n="roasting.title">{t.title}</span>
        </h2>
        <div class="h-1 w-20 bg-amber-500 rounded-full"></div>
        <div class="space-y-4 text-stone-300 leading-relaxed text-base sm:text-lg">
          <p>
            <span data-i18n="roasting.description_1">{t.description_1}</span>
          </p>
          <p class="text-stone-400 text-sm sm:text-base">
            <span data-i18n="roasting.description_2">{t.description_2}</span>
          </p>
        </div>
        <div class="pt-4">
          <a
            data-mailto-type="beans"
            data-mailto-email={email}
            data-i18n="roasting.order_beans"
            href={`mailto:${email}?subject=${encodeURIComponent("Заказ зерна")}`}
            class="inline-block px-8 py-4 bg-amber-800 hover:bg-amber-700 text-white font-medium rounded-xl transition-all duration-300"
          >
            {t.order_beans}
          </a>
        </div>
      </div>

      <!-- Right side: Two cards (Subscription & Gift Card) -->
      <div class="lg:col-span-6 space-y-8">
        <!-- Subscription card -->
        <div class="bg-stone-900/50 border border-stone-850 p-6 sm:p-8 rounded-2xl backdrop-blur-sm space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-950/50 border border-amber-900/50 flex items-center justify-center text-amber-500">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white font-serif">
              <span data-i18n="roasting.subscription">{t.subscription}</span>
            </h3>
          </div>
          <p class="text-stone-400 text-sm leading-relaxed">
            <span data-i18n="roasting.subscription_desc">{t.subscription_desc}</span>
          </p>
        </div>

        <!-- Gift card -->
        <div class="bg-stone-900/50 border border-stone-850 p-6 sm:p-8 rounded-2xl backdrop-blur-sm space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-950/50 border border-amber-900/50 flex items-center justify-center text-amber-500">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white font-serif">
              <span data-i18n="roasting.gift_card">{t.gift_card}</span>
            </h3>
          </div>
          <p class="text-stone-400 text-sm leading-relaxed">
            <span data-i18n="roasting.gift_card_desc">{t.gift_card_desc}</span>
          </p>
          <div class="pt-2">
            <a
              data-mailto-type="card"
              data-mailto-email={email}
              data-i18n="roasting.order_gift_card"
              href={`mailto:${email}?subject=${encodeURIComponent("Подарочная карта")}`}
              class="inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 text-sm font-semibold transition-colors duration-200"
            >
              <span>{t.order_gift_card}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
