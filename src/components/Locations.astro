---
import ru from "../i18n/ru.json";
import { locationsData } from "../data/locations";

const t = ru.locations;
const lang = "ru";
---

<section id="locations" class="py-20 px-4 md:px-[48px]" style="background-color: #f5f3ee;">
  <div class="max-w-[1200px] mx-auto">

    <h2
      data-i18n="locations.title"
      class="text-center mb-12"
      style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
    >
      {t.title}
    </h2>

    <!-- Location Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">

      {locationsData.map((location) => (
        location.status === "active" ? (
          <div
            class="flex flex-col h-full p-6"
            style="background-color: #ffffff; border-radius: 1rem; box-shadow: 0 1px 4px rgba(26, 47, 75, 0.08); border: 1px solid rgba(196, 198, 206, 0.2);"
          >
            <h3
              class="mb-2"
              style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #021a35;"
            >
              {location.name[lang]}
            </h3>
            <p class="mb-4 flex-grow" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #44474d; white-space: pre-line;">
              {location.address[lang]}
            </p>
            <div class="mb-6 space-y-1">
              {location.hours[lang].map((h) => (
                <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; color: #44474d;">{h}</p>
              ))}
            </div>
            <a
              href={location.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 mt-auto transition-all duration-200 hover:underline"
              style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #815500; text-decoration: none;"
            >
              <span class="material-symbols-outlined" style="font-size: 18px;">map</span>
              <span data-i18n="locations.route">{t.route}</span>
            </a>
          </div>
        ) : (
          <div
            class="relative flex flex-col h-full p-6 overflow-hidden"
            style="background-color: #1a2f4b; border-radius: 1rem; box-shadow: 0 1px 4px rgba(26, 47, 75, 0.15); border: 1px solid rgba(2, 26, 53, 0.2);"
          >
            <div
              class="absolute top-0 right-0 text-xs font-bold px-3 py-1"
              style="background-color: #fdb647; color: #6f4900; border-bottom-left-radius: 0.5rem; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.05em;"
            >
              СКОРО
            </div>

            <h3
              class="mb-2"
              style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #ffffff;"
            >
              {location.name[lang]}
            </h3>
            <p
              class="mb-4 flex-grow"
              style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #8397b8; white-space: pre-line;"
            >
              {location.address[lang]}
            </p>
            <div class="mt-auto">
              <p
                data-i18n="locations.status_soon"
                style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #ffb94d;"
              >
                {location.hours[lang][0]}
              </p>
            </div>
          </div>
        )
      ))}

    </div>

    <!-- Yandex Maps Widget Placeholder -->
    <div
      class="w-full flex items-center justify-center"
      style="height: 400px; background-color: #e4e2dd; border-radius: 1rem; border: 1px solid rgba(196, 198, 206, 0.3);"
    >
      <div class="text-center">
        <span class="material-symbols-outlined block mb-2" style="font-size: 48px; color: #74777e;">map</span>
        <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #44474d;">Яндекс.Карты · Виджет</p>
      </div>
    </div>

  </div>
</section>
