---
import ru from "../i18n/ru.json";

const t = ru.about;
---

<section id="about" class="py-24 sm:py-32 relative overflow-hidden bg-stone-900/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      
      <!-- History Text -->
      <div class="lg:col-span-7 space-y-6">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          <span data-i18n="about.title">{t.title}</span>
        </h2>
        <div class="h-1 w-20 bg-amber-500 rounded-full"></div>
        <p class="text-stone-300 leading-relaxed text-base sm:text-lg">
          <span data-i18n="about.history_1">{t.history_1}</span>
        </p>
        <p class="text-stone-400 leading-relaxed">
          <span data-i18n="about.history_2">{t.history_2}</span>
        </p>
      </div>

      <!-- Values Panel -->
      <div class="lg:col-span-5 bg-stone-900/50 border border-stone-850 p-8 sm:p-10 rounded-2xl backdrop-blur-sm space-y-8">
        <h3 class="text-xl sm:text-2xl font-bold text-white font-serif tracking-wide border-b border-stone-800 pb-4">
          <span data-i18n="about.values_title">{t.values_title}</span>
        </h3>
        
        <ul class="space-y-6">
          <li class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-950/50 border border-amber-900/50 flex items-center justify-center text-amber-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-stone-300 text-sm sm:text-base">
              <span data-i18n="about.value_direct">{t.value_direct}</span>
            </p>
          </li>
          
          <li class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-950/50 border border-amber-900/50 flex items-center justify-center text-amber-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <p class="text-stone-300 text-sm sm:text-base">
              <span data-i18n="about.value_eco">{t.value_eco}</span>
            </p>
          </li>
          
          <li class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-950/50 border border-amber-900/50 flex items-center justify-center text-amber-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <p class="text-stone-300 text-sm sm:text-base">
              <span data-i18n="about.value_edu">{t.value_edu}</span>
            </p>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
