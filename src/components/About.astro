---
import ru from "../i18n/ru.json";

const t = ru.about;
---

<section id="history" class="py-20 px-4 md:px-[48px]" style="background-color: #fbf9f4;">
  <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center gap-12">

    <!-- Text Content -->
    <div class="w-full md:w-1/2">
      <h2
        data-i18n="about.title"
        class="mb-6"
        style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
      >
        {t.title}
      </h2>
      <p
        data-i18n="about.history_1"
        class="mb-6"
        style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #1b1c19;"
      >
        {t.history_1}
      </p>
      <p
        data-i18n="about.history_2"
        class="mb-8"
        style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #1b1c19;"
      >
        {t.history_2}
      </p>

      <h3
        data-i18n="about.values_title"
        class="mb-4"
        style="font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 600; line-height: 32px; color: #021a35;"
      >
        {t.values_title}
      </h3>

      <ul class="space-y-4" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; line-height: 24px; color: #1b1c19;">
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined mt-0.5 flex-shrink-0" style="color: #815500;">handshake</span>
          <span data-i18n="about.value_direct">{t.value_direct}</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined mt-0.5 flex-shrink-0" style="color: #815500;">eco</span>
          <span data-i18n="about.value_eco">{t.value_eco}</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined mt-0.5 flex-shrink-0" style="color: #815500;">school</span>
          <span data-i18n="about.value_edu">{t.value_edu}</span>
        </li>
      </ul>
    </div>

    <!-- Photo -->
    <div class="w-full md:w-1/2 relative overflow-hidden shadow-md" style="aspect-ratio: 4/3; border-radius: 1rem; background-color: #f0eee9;">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('/images/about/team.jpg');"
        role="img"
        aria-label="Команда Бухты Coffee Roasters"
      ></div>
    </div>

  </div>
</section>
