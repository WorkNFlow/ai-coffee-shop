---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";
import { InteractiveHoverButton } from "./ui/interactive-hover-button";

const t = ru.careers;
---

<section id="careers" class="py-20 px-4 md:px-[48px]" style="background-color: #f5f3ee;">
  <div class="max-w-[1200px] mx-auto">

    <!-- Deep Navy Card -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left"
      style="background-color: #021a35; border-radius: 1.5rem; padding: 32px; padding-top: 48px; padding-bottom: 48px;"
    >

      <!-- Text -->
      <div class="md:w-2/3">
        <h2
          data-i18n="careers.title"
          class="mb-4"
          style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #ffffff;"
        >
          {t.title}
        </h2>
        <p
          data-i18n="careers.description"
          class="mb-6"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #8397b8;"
        >
          {t.description}
        </p>
        <p
          data-i18n="careers.positions_title"
          class="mb-3"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #b3c8eb; text-transform: uppercase;"
        >
          {t.positions_title}
        </p>
        <ul style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; color: #8397b8; list-style: disc; padding-left: 20px; text-align: left;">
          <li data-i18n="careers.barista">{t.barista}</li>
          <li data-i18n="careers.roaster">{t.roaster}</li>
        </ul>
      </div>

      <!-- CTA Button -->
      <div class="md:w-1/3 flex md:justify-end">
        <InteractiveHoverButton
          client:load
          href={`mailto:${contactsData.email}?subject=${encodeURIComponent('Отклик на вакансию')}`}
          data-mailto-type="career"
          data-mailto-email={contactsData.email}
          text={t.button}
          data-i18n="careers.button"
          variant="white"
          className="shadow-md hover:scale-105 transition-transform duration-300"
        />
      </div>

    </div>
  </div>
</section>
