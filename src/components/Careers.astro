---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";

const t = ru.careers;
const email = contactsData.email;
---

<section id="careers" class="py-24 sm:py-32 relative bg-stone-900/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      
      <!-- General description -->
      <div class="lg:col-span-5 space-y-6">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          <span data-i18n="careers.title">{t.title}</span>
        </h2>
        <div class="h-1 w-20 bg-amber-500 rounded-full"></div>
        <p class="text-stone-300 leading-relaxed text-base sm:text-lg">
          <span data-i18n="careers.description">{t.description}</span>
        </p>
      </div>

      <!-- Positions list -->
      <div class="lg:col-span-7 bg-stone-900/40 border border-stone-850 p-6 sm:p-8 rounded-2xl backdrop-blur-sm space-y-6">
        <h3 class="text-lg sm:text-xl font-bold text-white font-serif border-b border-stone-800 pb-3">
          <span data-i18n="careers.positions_title">{t.positions_title}</span>
        </h3>
        
        <div class="space-y-6">
          <!-- Position 1 -->
          <div class="p-5 rounded-xl bg-stone-900/60 border border-stone-850 hover:border-amber-900/30 transition-colors duration-200">
            <h4 class="text-stone-200 font-bold text-base sm:text-lg mb-2">
              <span data-i18n="careers.barista">{t.barista}</span>
            </h4>
            <p class="text-stone-400 text-xs sm:text-sm leading-relaxed mb-4">
              Ищем бариста с опытом работы или огромным желанием учиться. Если ты любишь людей, кофе и готов развиваться вместе с нами — ждем твой отклик.
            </p>
          </div>
          
          <!-- Position 2 -->
          <div class="p-5 rounded-xl bg-stone-900/60 border border-stone-850 hover:border-amber-900/30 transition-colors duration-200">
            <h4 class="text-stone-200 font-bold text-base sm:text-lg mb-2">
              <span data-i18n="careers.roaster">{t.roaster}</span>
            </h4>
            <p class="text-stone-400 text-xs sm:text-sm leading-relaxed mb-4">
              Помощь в обжарке, фасовка зерна, контроль качества и ведение складского учета. Обучим процессам спешелти-обжарки.
            </p>
          </div>
        </div>
        
        <div class="pt-4 text-center lg:text-left">
          <a
            data-mailto-type="career"
            data-mailto-email={email}
            data-i18n="careers.button"
            href={`mailto:${email}?subject=${encodeURIComponent("Отклик на вакансию")}`}
            class="inline-block px-8 py-4 bg-amber-800 hover:bg-amber-700 text-white font-medium rounded-xl transition-all duration-300"
          >
            {t.button}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
