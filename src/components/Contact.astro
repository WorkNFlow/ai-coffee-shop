---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";

const t = ru.contact;
---

<section id="contact" class="py-24 sm:py-32 relative bg-stone-900/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
          <span data-i18n="contact.title">{t.title}</span>
        </h2>
        <div class="h-1 w-20 bg-amber-500 rounded-full mx-auto"></div>
      </div>

      <!-- Contact Info Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
        <!-- Email -->
        <div class="bg-stone-900/30 border border-stone-850 p-6 rounded-2xl flex flex-col items-center md:items-start space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-950/40 border border-amber-900/50 flex items-center justify-center text-amber-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-stone-400 font-mono tracking-wider uppercase">
            <span data-i18n="contact.email_title">{t.email_title}</span>
          </h3>
          <a href={`mailto:${contactsData.email}`} class="text-white hover:text-amber-500 transition-colors font-medium text-base sm:text-lg">
            {contactsData.email}
          </a>
        </div>

        <!-- Phone -->
        <div class="bg-stone-900/30 border border-stone-850 p-6 rounded-2xl flex flex-col items-center md:items-start space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-950/40 border border-amber-900/50 flex items-center justify-center text-amber-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.73.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-stone-400 font-mono tracking-wider uppercase">
            <span data-i18n="contact.phone_title">{t.phone_title}</span>
          </h3>
          <a href={`tel:${contactsData.phone}`} class="text-white hover:text-amber-500 transition-colors font-medium text-base sm:text-lg">
            {contactsData.phone}
          </a>
        </div>

        <!-- Social Media -->
        <div class="bg-stone-900/30 border border-stone-850 p-6 rounded-2xl flex flex-col items-center md:items-start space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-950/40 border border-amber-900/50 flex items-center justify-center text-amber-500">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-stone-400 font-mono tracking-wider uppercase">Соцсети</h3>
          <div class="flex gap-4">
            <a 
              href={contactsData.instagram} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-white hover:text-amber-500 transition-colors font-medium text-sm sm:text-base flex items-center gap-1"
            >
              <span>Instagram</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <span class="text-stone-700">|</span>
            <a 
              href={contactsData.telegram} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-white hover:text-amber-500 transition-colors font-medium text-sm sm:text-base flex items-center gap-1"
            >
              <span>Telegram</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
