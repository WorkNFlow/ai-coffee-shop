---
import ru from "../i18n/ru.json";
import { contactsData } from "../data/contacts";

const t = ru.contact;
---

<section id="contact" class="py-20 px-4 md:px-[48px]" style="background-color: #fbf9f4;">
  <div class="max-w-[1200px] mx-auto text-center">

    <h2
      data-i18n="contact.title"
      class="mb-12"
      style="font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; font-weight: 600; line-height: 40px; color: #021a35;"
    >
      {t.title}
    </h2>

    <div class="flex flex-col md:flex-row justify-center items-center gap-12">

      <!-- Email -->
      <div>
        <p
          data-i18n="contact.email_title"
          class="mb-2"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #44474d;"
        >
          {t.email_title}
        </p>
        <a
          href={`mailto:${contactsData.email}`}
          class="transition-colors duration-200"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #021a35; text-decoration: none;"
          onmouseover="this.style.color='#815500'"
          onmouseout="this.style.color='#021a35'"
        >
          {contactsData.email}
        </a>
      </div>

      <!-- Divider -->
      <div class="hidden md:block" style="width: 1px; height: 48px; background-color: #c4c6ce;"></div>

      <!-- Phone -->
      <div>
        <p
          data-i18n="contact.phone_title"
          class="mb-2"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #44474d;"
        >
          {t.phone_title}
        </p>
        <a
          href={`tel:${contactsData.phone.replace(/\D/g, '')}`}
          class="transition-colors duration-200"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; line-height: 28px; color: #021a35; text-decoration: none;"
          onmouseover="this.style.color='#815500'"
          onmouseout="this.style.color='#021a35'"
        >
          {contactsData.phone}
        </a>
      </div>

      <!-- Divider -->
      <div class="hidden md:block" style="width: 1px; height: 48px; background-color: #c4c6ce;"></div>

      <!-- Social Links -->
      <div>
        <p class="mb-2" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; color: #44474d;">Соцсети</p>
        <div class="flex gap-4 justify-center">
          <a
            href={contactsData.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200 font-bold"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; color: #021a35; text-decoration: none;"
            onmouseover="this.style.color='#815500'"
            onmouseout="this.style.color='#021a35'"
          >
            Instagram
          </a>
          <a
            href={contactsData.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200 font-bold"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; color: #021a35; text-decoration: none;"
            onmouseover="this.style.color='#815500'"
            onmouseout="this.style.color='#021a35'"
          >
            Telegram
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
